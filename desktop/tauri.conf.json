{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ProxyMind",
  "version": "0.2.0",
  "identifier": "dev.proxymind.desktop",
  "build": {
    "frontendDist": "static"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "AI-native intercepting proxy for authorized security testing",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
